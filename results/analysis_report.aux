\@writefile{toc}{\contentsline {subsection}{\numberline {11.1}Swiss Roll との比較}{20}{subsection.11.1}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {15}{\ignorespaces MNIST（$m = 16$，200エポック）における学習ダイナミクス}}{20}{table.caption.37}\protected@file@percent }

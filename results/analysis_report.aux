\@writefile{lot}{\contentsline {table}{\numberline {18}{\ignorespaces Torus：測地線相関の $k$-NN パラメータ感度（$k = 5, 10, 15, 20, 30$）}}{24}{table.caption.44}\protected@file@percent }
\newlabel{tab:e5ext_torus}{{18}{24}{Torus：測地線相関の $k$-NN パラメータ感度（$k = 5, 10, 15, 20, 30$）}{table.caption.44}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {12}{\ignorespaces 実験 E5\_extended：測地線距離相関の $k$ 値感度分析．各線は異なるボトルネック次元 $m$ に対応する．Swiss Roll では $m = 2, 3, 4$ が $m = 1$ を上回る順序が $k$ 全域で安定している（定理7の確認）．Torus では $m = 3$ が全 $k$ で最高値を示す（位相的最小埋め込み次元との対応）．}}{24}{figure.caption.45}\protected@file@percent }
\newlabel{fig:e5ext}{{12}{24}{実験 E5\_extended：測地線距離相関の $k$ 値感度分析．各線は異なるボトルネック次元 $m$ に対応する．Swiss Roll では $m = 2, 3, 4$ が $m = 1$ を上回る順序が $k$ 全域で安定している（定理7の確認）．Torus では $m = 3$ が全 $k$ で最高値を示す（位相的最小埋め込み次元との対応）．}{figure.caption.45}{}}

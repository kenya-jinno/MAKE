\newlabel{tab:eb}{{16}{22}{各多様体の位相的性質と VAE（$\beta = 4$）の AU 飽和値}{table.caption.40}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {11}{\ignorespaces 実験 EB：位相的 AU 実験．各多様体における VAE（$\beta =4$）の AU の $m$ 依存性．Torus および Möbius Band では $m = 3$ での AU 飽和が確認でき，位相的最小埋め込み次元（3）と一致する．Swiss Roll は $m = 3$ で飽和するが期待値（2）とは不一致（螺旋の大域構造の影響）．}}{22}{figure.caption.41}\protected@file@percent }
\newlabel{fig:eb}{{11}{22}{実験 EB：位相的 AU 実験．各多様体における VAE（$\beta =4$）の AU の $m$ 依存性．Torus および Möbius Band では $m = 3$ での AU 飽和が確認でき，位相的最小埋め込み次元（3）と一致する．Swiss Roll は $m = 3$ で飽和するが期待値（2）とは不一致（螺旋の大域構造の影響）．}{figure.caption.41}{}}
\@writefile{toc}{\contentsline {paragraph}{分析}{22}{section*.42}\protected@file@percent }

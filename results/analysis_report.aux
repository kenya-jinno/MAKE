\@writefile{toc}{\contentsline {section}{\numberline {14}実験 EC：等長 AE（デコーダヤコビアン正則化による等長性改善）}{25}{section.14}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {14.1}IsometricAE vs 既存モデルの比較}{25}{subsection.14.1}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {19}{\ignorespaces Swiss Roll（$m = 2$，200エポック）における IsometricAE と既存モデルの比較}}{25}{table.caption.47}\protected@file@percent }
\newlabel{tab:ec}{{19}{25}{Swiss Roll（$m = 2$，200エポック）における IsometricAE と既存モデルの比較}{table.caption.47}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {13}{\ignorespaces 実験 EC：等長 AE の比較（Swiss Roll，$m = 2$，200エポック）．IsometricAE はデコーダ側のヤコビアン正則化$\|J_g^\top J_g - I\|_F^2$ により条件数 $\kappa = 1.040$（等長性が大幅改善）を達成する．CAE（エンコーダ収縮）は条件数が最悪（1.531）であり，エンコーダ側正則化がデコーダのプルバック計量を歪めることを示す．}}{25}{figure.caption.48}\protected@file@percent }
\newlabel{fig:ec}{{13}{25}{実験 EC：等長 AE の比較（Swiss Roll，$m = 2$，200エポック）．IsometricAE はデコーダ側のヤコビアン正則化$\|J_g^\top J_g - I\|_F^2$ により条件数 $\kappa = 1.040$（等長性が大幅改善）を達成する．CAE（エンコーダ収縮）は条件数が最悪（1.531）であり，エンコーダ側正則化がデコーダのプルバック計量を歪めることを示す．}{figure.caption.48}{}}
\@writefile{toc}{\contentsline {paragraph}{分析}{25}{section*.49}\protected@file@percent }
